def es_un_primo(numero):
    es_primo = True
    if numero < 2:
        es_primo = False
    for i in range (2, numero):
        if numero % i == 0:
            es_primo = False
    if es_primo:
        return True
    else:
        return False

numero = int(input("Escribe un número: "))
resultado = es_un_primo(numero)

if resultado:
    print(numero, "es un número primo")
else:
    print(numero, "no es un primo")
